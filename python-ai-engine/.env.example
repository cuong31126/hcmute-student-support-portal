# ============================================================
# QAUTE Portal — Python AI Engine
# Cấu hình môi trường — copy file này thành .env và điền key thật
# ============================================================

# Google Gemini API Key (giống với Spring Boot)
GEMINI_API_KEY=demo_key

# Model sử dụng cho Chat và Embedding
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Cổng Python AI Engine chạy
AI_ENGINE_PORT=8001
AI_ENGINE_HOST=127.0.0.1

# Thư mục chứa file PDF tài liệu quy chế (tuyệt đối hoặc tương đối với python-ai-engine/)
PDF_SOURCE_DIR=D:\HK5\CongNghePhanMem\tailieuAI

# Thư mục lưu ChromaDB vector store (persistent)
CHROMA_PERSIST_DIR=./data/chroma_db

# Thư mục lưu file Markdown đã convert từ PDF
MARKDOWN_OUTPUT_DIR=./data/markdown_docs

# Token budget cho RAG context (chars UTF-8 ~ tokens)
CONTEXT_TOKEN_BUDGET_CHARS=3000

# Threshold confidence gợi ý tạo Ticket
SUGGEST_TICKET_THRESHOLD=0.45

# Số chunk tối đa trả về từ vector search
TOP_K_CHUNKS=5

# Debug mode
DEBUG=false
